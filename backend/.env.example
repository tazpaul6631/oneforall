PORT=3000
DB_PATH=data/app.db
JWT_SECRET=doi-chuoi-nay-truoc-khi-len-production
# Production: systemd đặt NODE_ENV=production. JWT_SECRET phải là chuỗi ngẫu nhiên dài.
# CORS_ORIGIN để trống = chỉ website cùng domain được gọi API. Nhiều domain thì cách nhau bởi dấu phẩy.
NODE_ENV=development
CORS_ORIGIN=
BACKUP_DIR=data/backups
# Tài khoản vận hành, không thuộc cửa hàng nào. Đổi mật khẩu trước khi mở cho khách.
OPERATOR_EMAIL=ops@local.test
OPERATOR_PASSWORD=Operator@12345
